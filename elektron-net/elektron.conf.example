# ============================================================
# Elektron Net node config -- node1.elektron-net.org (mainnet)
# Mounted read-only into the container at /data/elektron.conf
#
# elektron.conf is the preferred filename for this config; the fork's
# Bitcoin Core-inherited default filename, bitcoin.conf, is still fully
# respected too (elektrond is always started with an explicit -conf= flag
# here, see the Dockerfile CMD, so either filename works identically --
# this is purely a naming preference, not a functional difference).
# ============================================================

server=1
listen=1
bind=0.0.0.0:8333

# Seed node: accept inbound P2P from anywhere.
maxconnections=125

# --- RPC ---
# Bind on all interfaces INSIDE the container, but 8332 is never published
# to the host (see docker-compose.yml) -- only reachable from sibling
# containers (the pool backend, elektron-faucet-app) on the "backend" network.
rpcbind=0.0.0.0
rpcallowip=172.16.0.0/12

# Generate with: python3 elektron-net/share/rpcauth/rpcauth.py elektron_svc
# then paste the resulting "rpcauth=..." line here (3 lines of output: the
# rpcauth= line, your plaintext password to give to the pool/faucet .env
# files, and a reminder). Do NOT commit the real value to git.
#rpcauth=elektron_svc:REPLACE_WITH_GENERATED_SALT$REPLACE_WITH_GENERATED_HASH

# --- ZMQ (optional, speeds up the pool backend's block-change detection) ---
zmqpubrawblock=tcp://0.0.0.0:28332
zmqpubrawtx=tcp://0.0.0.0:28333

# --- Wallet ---
# Needed so the pool's POOL_WALLET_ADDRESS (POOL_TYPE=ppool only -- the
# solo pool, POOL_TYPE=pool, has no pool wallet) and the faucet's hot
# wallet can live on this same node. Create/encrypt wallets after first
# start via `docker compose exec elektron-net elektron-cli createwallet ...`.
disablewallet=0

# Auto-load these wallets on every node startup -- without this, a restart
# leaves listwallets empty and pool/faucet payouts fail until someone runs
# `loadwallet` by hand. Remove the "wallet=pool" line entirely if you're
# running POOL_TYPE=pool (no pool wallet to load).
wallet=pool
wallet=faucet

# Note: pruning is MANDATORY and automatic on Elektron Net (197,280-block
# depth) -- there is no -prune= setting to configure; it's ignored by design.
