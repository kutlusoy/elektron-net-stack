# Copy this file's content into the REAL elektron-net-pool/.env after
# `git clone`. Values below assume the master docker-compose.yml in this
# repo, where the node is reachable by its Compose service name.
#
# This is the solo pool (POOL_TYPE=pool): miners are paid directly to their
# own coinbase address, so there is no pool wallet, no PPLNS section and no
# JWT miner-login section here -- see the README, "Pool type: ppool vs.
# pool", for the full comparison against elektron-net-ppool/.env.example.

# "elektron-net" = Compose service name of the node, resolvable on the
# shared "backend" network -- NOT host.docker.internal (that's only for a
# node running natively outside Docker).
ELEKTRON_RPC_URL=http://elektron-net

# Must match the rpcauth line you generated for elektron-net/elektron.conf.
ELEKTRON_RPC_USER=elektron_svc
ELEKTRON_RPC_PASSWORD=REPLACE_WITH_THE_PLAINTEXT_PASSWORD_FROM_RPCAUTH_PY
ELEKTRON_RPC_PORT=8332
ELEKTRON_RPC_TIMEOUT=10000

# You can use this instead of ELEKTRON_RPC_USER and ELEKTRON_RPC_PASSWORD
ELEKTRON_RPC_COOKIEFILE=

ELEKTRON_ZMQ_HOST=tcp://elektron-net:28332

API_PORT=3334
STRATUM_PORT=3333
STRATUM_MAX_CONNECTIONS_PER_LISTENER=10000

# Per-miner template push cadence. Lower values keep ntime advancing for
# high-end ASICs (Bitaxe Gamma, Antminer S21) that exhaust the
# (nonce, version) search space inside a single ntime window; raise it if your
# upstream node strains under getblocktemplate load. clearJobs is only set on
# height changes, so a faster cadence does not invalidate in-flight work.
# Min 1000 ms (hard floor), default 30000.
JOB_REFRESH_INTERVAL_MS=30000

# How often the per-session vardiff re-evaluates the share submission rate
# and adjusts the session difficulty. Min 5000 ms (hard floor), default 60000.
DIFFICULTY_CHECK_INTERVAL_MS=60000

# Optional Telegram notifications. No *_USERNAME variant here -- unlike
# elektron-net-ppool, the solo pool has no per-account miner login, so
# notifications are pool-wide only.
#TELEGRAM_BOT_TOKEN=

# Optional Discord notifications.
#DISCORD_BOT_CLIENTID=
#DISCORD_BOT_GUILD_ID=
#DISCORD_BOT_CHANNEL_ID=

# Optional dev fee (small percentage of found blocks paid to this address).
DEV_FEE_ADDRESS=

NETWORK=mainnet
API_SECURE=false
POOL_IDENTIFIER="Elektron Solo Pool"

# Optional. Embedded on-chain as a dedicated OP_RETURN output in every block
# this pool finds, alongside POOL_IDENTIFIER (see elektron-net-pool
# doc-elektron/guideline-pool-identity-op-return.md). Leave empty to skip
# that output entirely.
POOL_URL=https://pool.elektron-net.org

# Hobby-miner compatibility: comma-separated userAgent substrings (case-insensitive).
# Matching miners get a low starting difficulty so a few-kH/s ESP32 device
# actually submits shares before the pool's dead-client timeout fires.
HOBBY_MINER_USER_AGENTS=NerdMiner,NerdminerV2,nerdminer,NerdAxe,NerdQAxe
HOBBY_MINER_DIFFICULTY=0.001

DIAGNOSTIC_SHARE_LOGGING_MODES=
