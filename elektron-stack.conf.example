# Elektron Net Stack -- config file for install-elektron-stack.sh
#
# How to use:
#   1. Copy this file:  cp elektron-stack.conf.example elektron-stack.conf
#   2. Fill in your real values in elektron-stack.conf (see below).
#   3. Place the file next to install-elektron-stack.sh on the server
#      (e.g. upload via scp, or create it directly in your provider's
#      console editor).
#   4. ./install-elektron-stack.sh
#      (elektron-stack.conf is found automatically as long as it sits in
#      the same directory as the script -- or point at it explicitly:
#      ./install-elektron-stack.sh --config /path/to/elektron-stack.conf)
#
# Anything you do NOT fill in here (leave the line blank or omit it
# entirely) is -- if the script is running interactively -- asked on the
# console, or falls back to the built-in default (--yes). Passwords/secrets
# left blank are generated securely and automatically.
#
# IMPORTANT: once filled in, this file holds your real credentials --
# do not commit it (already in .gitignore), chmod 600.

# --- General ---
STACK_DIR=/opt/elektron-net-stack
GITHUB_USER=kutlusoy
# false (default) = never touch already-cloned repos on a rerun.
# true = before building, check each cloned repo with "git fetch" and
# update it via "git pull --ff-only" if there are new commits (never
# force/rebase -- a diverged local branch is only reported, never
# touched). Asked interactively unless set here or --yes is used.
AUTO_UPDATE_REPOS=false
SERVER_IP=46.225.163.85
SERVER_IPV6=2a01:4f8:1c18:ea01::1

# --- Domains (must already point at SERVER_IP/SERVER_IPV6 in DNS) ---
NODE_DOMAIN=node1.elektron-net.org
POOL_DOMAIN=pplns.elektron-net.org
FAUCET_DOMAIN=faucet.elektron-net.org
CADDY_EMAIL=

# --- Node / RPC ---
RPC_USER=elektron_svc

# --- Firewall ---
FIREWALL_AUTO_CONFIGURE=true

# --- Pool (elektron-net-ppool OR elektron-net-pool -- pick exactly one) ---
INSTALL_POOL=true
# 'ppool' = elektron-net-ppool, a shared PPLNS pool with its own payout
#           ledger and pool wallet (the settings below through JWT_SECRET
#           apply to this type only).
# 'pool'  = elektron-net-pool, a solo pool: every miner is paid directly to
#           their own address in the coinbase, no pool wallet/ledger/JWT.
# Only ONE of the two is ever installed/started at a time -- both reuse the
# same STRATUM_PORT/API_PORT, so running both together would collide.
# Switching this later (INSTALL_POOL staying true) stops+removes the other
# type's containers on the next run; its data directory is kept untouched.
POOL_TYPE=ppool
POOL_WALLET_NAME=pool
# leave empty to auto-generate. Encrypts the pool wallet -- without this,
# any real payout fails as soon as PAYOUT_DRY_RUN=false is set.
# (POOL_TYPE=ppool only -- POOL_TYPE=pool has no pool wallet.)
POOL_WALLET_PASSPHRASE=
WALLET_UNLOCK_SECONDS=60
POOL_IDENTIFIER=Elektron PPLNS Pool
# Optional -- embedded on-chain as a dedicated OP_RETURN output in every
# block this pool finds, alongside POOL_IDENTIFIER (see
# doc-elektron/guideline-pool-identity-op-return.md in the pool repo).
# Leave empty to skip that output entirely. A bare domain (no http(s)://)
# gets "https://" prefixed automatically by the install script.
POOL_URL=https://pplns.elektron-net.org
# Optional -- routes a small development fee to this address. Leave empty
# to skip it entirely. Applies to both POOL_TYPE values.
DEV_FEE_ADDRESS=
# The following, through JWT_SECRET, apply to POOL_TYPE=ppool only.
POOL_FEE_PERCENT=1.0
PPLNS_WINDOW_MINUTES=90
MIN_PAYOUT_THRESHOLD_SATS=100000
PAYOUT_INTERVAL_MINUTES=60
PAYOUT_CONFIRMATIONS_REQUIRED=1
PAYOUT_DRY_RUN=true
STRATUM_PORT=3333
API_PORT=3334
# leave empty to auto-generate (openssl rand -hex 32):
JWT_SECRET=

# Optional -- Telegram bot for miner notifications (/subscribe <address>).
# Leave both empty to disable the feature entirely. TELEGRAM_BOT_USERNAME
# is purely cosmetic (just the displayed link).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional -- Discord bot. All four must be set together, otherwise the
# integration stays disabled.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENTID=
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_CHANNEL_ID=

# --- Faucet (elektron-net-faucet) ---
FAUCET_WALLET_NAME=faucet
# leave empty to auto-generate:
FAUCET_WALLET_PASSPHRASE=
FAUCET_DB_NAME=elek_faucet
FAUCET_DB_USER=elek_faucet
# leave empty to auto-generate:
FAUCET_DB_PASS=
FAUCET_DB_ROOT_PASS=
FAUCET_ADMIN_USER=admin
# leave empty to auto-generate (min. 10 characters):
FAUCET_ADMIN_PASS=
# from hcaptcha.com -- strongly recommended, but optional:
FAUCET_HCAPTCHA_SITE=
FAUCET_HCAPTCHA_SECRET=
FAUCET_TITLE=Elektron Net Faucet
FAUCET_MESSAGE=Claim some free ELEK!
FAUCET_AMOUNT_ELEK=0.001
FAUCET_DAILY_BUDGET=1
FAUCET_HOURLY_BUDGET=0.1
FAUCET_PER_ADDR_COOLDOWN_H=24
FAUCET_PER_IP_COOLDOWN_H=1
FAUCET_DEFAULT_LANG=de
# Optional -- block explorer link shown after a successful claim
# (e.g. https://explorer.example.com):
FAUCET_EXPLORER_URL=
# Minutes between checks whether the faucet's own payouts are still
# unconfirmed in the mempool because the node's current minimum fee
# (mempoolminfee) has since risen above what was originally paid -- if so,
# it gets bumped to a higher fee via RBF. Also changeable later at any time
# without a restart, in the Admin Panel under "Mempool & Fee Bumping":
FAUCET_FEE_BUMP_INTERVAL_MIN=10

# --- Seeder (elektron-net-seeder) -- OPTIONAL, still in testing ---
# true = also clone/build/start it (Compose profile "seeder"). Needs its
# own NS delegation for SEEDER_HOST in DNS, see README.
INSTALL_SEEDER=false
SEEDER_HOST=seeder.eleknet.org
SEEDER_NS=node1.elektron-net.org
SEEDER_MBOX=admin.eleknet.org
SEEDER_DNS_PORT=53
SEEDER_THREADS=96
SEEDER_DNS_THREADS=4
SEEDER_MIN_HEIGHT=70000                # young chain -- below the seeder's built-in mainnet default of 350000

# --- Mempool Explorer (elektron-net-mempool) -- OPTIONAL, but stable ---
# true = also clone/build/start it (Compose profile "mempool"). Needs no
# new port -- runs behind Caddy just like Pool/Faucet.
# Automatically also installs elektron-net-electrs (the Electrum server
# for the explorer's address search, same profile, removed together with it).
INSTALL_MEMPOOL=true
MEMPOOL_DOMAIN=mempool.elektron-net.org
MEMPOOL_DB_NAME=mempool
MEMPOOL_DB_USER=mempool
# leave empty to auto-generate:
MEMPOOL_DB_PASS=
MEMPOOL_DB_ROOT_PASS=
# without -txindex: backfilling old blocks needs a full block-file access
# per block -- keep this small, see elektron-net-mempool/docker-compose.yml
MEMPOOL_INDEXING_BLOCKS_AMOUNT=1000
# true = enable the "Acceleration" menu item (dashboard) AND the "Boost"
# button on the tx page in the explorer frontend. Both only link out to
# mempool.space's own (paid) fee-acceleration service -- a plain outbound
# HTTPS request to SERVICES_API, no additional port/firewall rule needed.
# false = menu item and button stay hidden, like the original Mempool
# frontend without these flags.
MEMPOOL_ACCELERATOR=true
